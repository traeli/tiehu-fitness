# Image/version label.
APP_VERSION=2026.08.31
TZ=Asia/Shanghai

# Go module download acceleration for image builds in mainland China.
GO_BUILD_GOPROXY=https://goproxy.cn,direct
GO_BUILD_GOSUMDB=sum.golang.google.cn

# Existing containers attached to the external Docker network named "shared".
REDIS_ADDR=nutrilens-redis:6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Use two databases and two roles inside the existing PostgreSQL instance.
# URL-encode reserved characters in passwords before placing them in a DSN.
CORE_DATABASE_DSN=postgres://tiehu_core:replace_core_password@nutrilens-pg:5432/tiehu_core?sslmode=disable
VISION_DATABASE_DSN=postgres://tiehu_vision:replace_vision_password@nutrilens-pg:5432/tiehu_vision?sslmode=disable

# Core authentication integration.
UTOOLS_PLUGIN_ID=replace_utools_plugin_id
UTOOLS_PLUGIN_SECRET=replace_utools_plugin_secret
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Public WSS address returned to the uTools client. It must terminate TLS and
# proxy to 127.0.0.1:8100 on this host.
REALTIME_WEBSOCKET_URL=wss://vision.example.com/v1/realtime/transcriptions

# Optional provider endpoint overrides. Usually keep these values unchanged.
BAILIAN_ASR_ENDPOINT=
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions

# Bind only to loopback when host Nginx/Caddy provides public HTTPS/WSS.
CORE_BIND_ADDRESS=127.0.0.1
CORE_HTTP_PORT=8000
VISION_BIND_ADDRESS=127.0.0.1
VISION_HTTP_PORT=8100
