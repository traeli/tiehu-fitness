# Copy this file to configs/docker-compose.env and replace the remaining change_me values.
# configs/docker-compose.env is ignored by Git because it contains local credentials and DSNs.

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_postgres_admin
POSTGRES_ADMIN_DATABASE=postgres

CORE_DATABASE_USER=tiehu_core_app
CORE_DATABASE_PASSWORD=change_me_core_database
CORE_DATABASE_NAME=tiehu_core
CORE_DATABASE_DSN=postgres://tiehu_core_app:change_me_core_database@127.0.0.1:5432/tiehu_core?sslmode=disable

# Local development values matching configs/vision.yaml.
VISION_DATABASE_USER=tiehu
VISION_DATABASE_PASSWORD=tiehu
VISION_DATABASE_NAME=tiehu
VISION_DATABASE_DSN=postgres://tiehu:tiehu@127.0.0.1:5432/tiehu?sslmode=disable

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_ADMIN_USERNAME=tiehu_admin
REDIS_ADMIN_PASSWORD=change_me_redis_admin

CORE_REDIS_ADDR=127.0.0.1:6379
CORE_REDIS_USERNAME=tiehu_core
CORE_REDIS_PASSWORD=change_me_core_redis

VISION_REDIS_ADDR=127.0.0.1:6379
VISION_REDIS_USERNAME=tiehu_vision
VISION_REDIS_PASSWORD=change_me_vision_redis
